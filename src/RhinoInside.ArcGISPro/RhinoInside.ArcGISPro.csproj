<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.3.0</Version>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- CS0162 is emitted only from temporary C# generated by Esri's pack/deploy target (not
         from add-in source). Keep release output actionable while retaining all other warnings. -->
    <NoWarn>$(NoWarn);CA1416;CS0162</NoWarn>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <!-- The Rhino COM type library reference was removed: ResolveComReference is unsupported by
       .NET Core MSBuild (MSB4803), and VS 2022's MSBuild 17.x cannot target net10 at all.
       Rhino.Inside hosts Rhino in-process through RhinoCommon, so the COM interop is not needed. -->
  <ItemGroup>
    <Content Include="Config.daml" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Images\AddInDesktop16.png" />
    <Content Include="Images\AddInDesktop32.png" />
    <Content Include="DarkImages\AddInDesktop16.png" />
    <Content Include="DarkImages\AddInDesktop32.png" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="ViewModel\" />
  </ItemGroup>
  <ItemGroup>
    <!-- The interop stack: a pure core plus one adapter per SDK. RhinoArcGIS.Rhino pulls in
         RhinoCommon as a compile-time reference only, so nothing here places a RhinoCommon copy in
         the add-in folder that would shadow the one RhinoHost loads from the Rhino install. -->
    <ProjectReference Include="..\RhinoArcGIS.Core\RhinoArcGIS.Core.csproj" />
    <ProjectReference Include="..\RhinoArcGIS.ArcGIS\RhinoArcGIS.ArcGIS.csproj" />
    <ProjectReference Include="..\RhinoArcGIS.Rhino\RhinoArcGIS.Rhino.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Reference-only. At run time Rhino.Inside loads the real RhinoCommon out of the Rhino 8
         install; a copy in the add-in folder would shadow it and break in-process hosting.
         Compile references stay pinned to 8.23; the installed Rhino 8 provides the runtime. -->
    <PackageReference Include="RhinoCommon" Version="8.23.25251.13001" ExcludeAssets="runtime" />
    <!-- Rhino.Inside 8 declares Grasshopper >= 8.0. Without a direct pin NuGet chooses 8.0,
         whose exact RhinoCommon dependency conflicts with the pinned 8.23 compile reference.
         Keep both compile-only references on the same Rhino service release. -->
    <PackageReference Include="Grasshopper" Version="8.23.25251.13001" ExcludeAssets="runtime" />
    <PackageReference Include="Rhino.Inside" Version="8.0.7-beta" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ArcGIS.CoreHost">
      <HintPath>C:\Program Files\ArcGIS\Pro\bin\ArcGIS.CoreHost.dll</HintPath>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Charts.Wpf">
      <HintPath>C:\Program Files\ArcGIS\Pro\bin\ArcGIS.Desktop.Charts.Wpf.dll</HintPath>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Docking.Wpf">
      <HintPath>C:\Program Files\ArcGIS\Pro\bin\ArcGIS.Desktop.Docking.Wpf.dll</HintPath>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Editors.Interop.DataGrid.Wpf">
      <HintPath>C:\Program Files\ArcGIS\Pro\bin\ArcGIS.Desktop.Editors.Interop.DataGrid.Wpf.dll</HintPath>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Editors.Wpf">
      <HintPath>C:\Program Files\ArcGIS\Pro\bin\ArcGIS.Desktop.Editors.Wpf.dll</HintPath>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Framework">
      <HintPath>C:\Program Files\ArcGIS\Pro\bin\ArcGIS.Desktop.Framework.dll</HintPath>
      <CopyLocal>False</CopyLocal>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.Core">
      <HintPath>C:\Program Files\ArcGIS\Pro\bin\ArcGIS.Core.dll</HintPath>
