      <HintPath>C:\Program Files\ArcGIS\Pro\bin\ArcGIS.Desktop.Text.LLParser.Wpf.dll</HintPath>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Text.Wpf">
      <HintPath>C:\Program Files\ArcGIS\Pro\bin\ArcGIS.Desktop.Text.Wpf.dll</HintPath>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Views.Wpf">
      <HintPath>C:\Program Files\ArcGIS\Pro\bin\ArcGIS.Desktop.Views.Wpf.dll</HintPath>
    </Reference>
    <Reference Include="ArcGISPro">
      <HintPath>C:\Program Files\ArcGIS\Pro\bin\ArcGISPro.dll</HintPath>
    </Reference>
    <Reference Include="ESRI.ArcGIS.ItemIndex">
      <HintPath>C:\Program Files\ArcGIS\Pro\bin\ESRI.ArcGIS.ItemIndex.dll</HintPath>
      <CopyLocal>False</CopyLocal>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <!-- ArcGIS is the host. Never redistribute its installed SDK/runtime assemblies. -->
  <ItemGroup>
    <Reference Update="ArcGIS*;ESRI.*">
      <Private>False</Private>
      <CopyLocal>False</CopyLocal>
    </Reference>
  </ItemGroup>
  <!-- Compile-only validation must not import Esri's package/deploy targets or register the add-in. -->
  <Import Project="C:\Program Files\ArcGIS\Pro\bin\Esri.ProApp.SDK.Desktop.targets" Condition="'$(SkipAddinPackaging)' != 'true' AND Exists('C:\Program Files\ArcGIS\Pro\bin\Esri.ProApp.SDK.Desktop.targets') AND !Exists('Esri.ArcGISPro.Extensions.targets')" />
  <!-- The SDK copies into temp_archive but its cleanup uses ZipIntermediatePath. Set the
       actual staging path so old host DLLs cannot survive a change to CopyLocal metadata. -->
  <Target Name="SetPackageArchiveDirectory" BeforeTargets="PackageArcGISContents">
    <PropertyGroup>
      <ZipIntermediatePath>$(IntermediateOutputPath)temp_archive\</ZipIntermediatePath>
    </PropertyGroup>
  </Target>
</Project>
